# =====================================================================
# ashare-invest-assistant 环境变量示例（只放变量名与占位值，绝不放真实值）
# 使用：deploy/scripts/up.sh 首次运行时会自动复制为 deploy/env/.env（已被 .gitignore 排除）
# 该文件只用于 docker compose 的变量插值（--env-file），不会整体注入任何容器；
# 每个容器拿到哪些变量，以 deploy/compose/docker-compose.yml 中的 environment 为准。
# =====================================================================

# --- compose ---
COMPOSE_PROJECT_NAME=aia
# 宿主机只在 127.0.0.1 上暴露 nginx
NGINX_HTTP_PORT=8080

# --- PostgreSQL 16 + TimescaleDB ---
POSTGRES_USER=aia
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=aia

# --- 应用通用（api / worker / signal-rt / beat / ingest） ---
APP_ENV=local
# 32 字节以上随机串；本地占位，生产用 openssl rand -base64 48 生成
APP_MASTER_KEY=change-me-local-master-key-placeholder
PUBLIC_BASE_URL=http://localhost:8080
SESSION_COOKIE_SECURE=false
IMPORT_STORAGE_BACKEND=local
IMPORT_STORAGE_PATH=/var/lib/aia-dev/imports

# --- SMTP（本地不发信） ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- 麦蕊（只注入 ingest 容器，plan §2.1A） ---
# 回放模式开关：replay = 读取录制的脱敏 fixtures，不访问麦蕊（本地/CI 默认）；live = 真实调用（仅唯一调用方主机）
MAIRUI_MODE=replay
MAIRUI_REPLAY_DIR=/fixtures/mairui
# 留空。真实 licence 只在"当前唯一调用方"主机的 .env 中填写，绝不入库
MAIRUI_LICENCE=
MAIRUI_BASE_URL=https://api.mairuiapi.com
MAIRUI_PRO_BASE_URL=https://pro.mairuiapi.com
MAIRUI_EGRESS_IP_EXPECTED=
