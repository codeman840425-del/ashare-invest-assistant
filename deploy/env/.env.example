# =====================================================================
# ashare-invest-assistant 环境变量示例（只放变量名与占位值，绝不放真实值）
# 使用：deploy/scripts/up.sh 首次运行时会自动复制为 deploy/env/.env（已被 .gitignore 排除）
# 该文件只用于 docker compose 的变量插值（--env-file），不会整体注入任何容器；
# 每个容器拿到哪些变量，以 deploy/compose/docker-compose.yml 中的 environment 为准。
# =====================================================================

# --- compose ---
# 每个工作树/克隆一个项目名（T-O03）。留空 = 按工作树目录名派生 aia-<目录名>。
# 优先级：本文件 > 派生；shell 里导出的 COMPOSE_PROJECT_NAME 不生效（见 deploy/scripts/compose.sh）。
# 同一台机器上多个工作树同时运行时，还要给每个工作树不同的 NGINX_HTTP_PORT / POSTGRES_HOST_PORT / REDIS_HOST_PORT。
COMPOSE_PROJECT_NAME=
# 数据卷名前缀：卷名为 <前缀>_pgdata / _redisdata / _imports。留空 = 项目名。
# 项目改名但要沿用旧卷时，设为旧项目名（例如 aia）。
AIA_VOLUME_PREFIX=
# 宿主机只在 127.0.0.1 上暴露 nginx
NGINX_HTTP_PORT=8080
# dev 叠加层在 127.0.0.1 上暴露的 postgres / redis 端口
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379

# --- PostgreSQL 16 + TimescaleDB ---
POSTGRES_USER=aia
POSTGRES_PASSWORD=changeme-local-only
POSTGRES_DB=aia

# --- 应用通用（api / worker / signal-rt / beat / ingest） ---
APP_ENV=local
# 32 字节以上随机串；本地占位，生产用 openssl rand -base64 48 生成
APP_MASTER_KEY=changeme-local-master-key-placeholder
PUBLIC_BASE_URL=http://localhost:8080
# 会话 Cookie 的 Secure 标记：本地 http 调试 false；live/生产 profile 必须 true（且 PUBLIC_BASE_URL 用 https）。
# APP_ENV 不是 local/test 时设为 false → 后端启动失败（plan 6.1）。
SESSION_COOKIE_SECURE=false
# 注册模式（契约 registration_mode）：closed（V1 默认，/auth/register → 503 REGISTRATION_CLOSED，本人账号用 CLI 创建）
# | invite（邀请码 + 审核，需 T-B03c）| open（保留，V1 不用）。live/生产也用 closed。
REGISTRATION_MODE=closed
IMPORT_STORAGE_BACKEND=local
IMPORT_STORAGE_PATH=/var/lib/aia-dev/imports
# 日志级别：DEBUG / INFO / WARNING / ERROR（后端 Settings.log_level）
LOG_LEVEL=INFO

# --- 后端 api（T-O01a；容器内 CONFIG_DIR 固定为 /app/config，DATABASE_URL/REDIS_URL 由 compose 拼装） ---
# 路由前缀；改了要同步 nginx 的 location /api/
API_PREFIX=/api/v1
# /health 探测 PG/Redis 的单项超时（秒）
HEALTH_CHECK_TIMEOUT_S=1.0
# 后端镜像 tag（由 deploy/docker/backend.Dockerfile 构建）。留空 = aia-backend:<项目名>，各工作树互不覆盖
AIA_BACKEND_IMAGE=

# --- SMTP（本地不发信） ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- 麦蕊（只注入 ingest 容器，plan §2.1A） ---
# 回放模式开关：replay = 读取录制的脱敏 fixtures，不访问麦蕊（本地/CI 默认）；live = 真实调用（仅唯一调用方主机）
MAIRUI_MODE=replay
MAIRUI_REPLAY_DIR=/fixtures/mairui
# 留空。真实 licence 只在"当前唯一调用方"主机的 .env 中填写，绝不入库
MAIRUI_LICENCE=
MAIRUI_BASE_URL=https://api.mairuiapi.com
MAIRUI_PRO_BASE_URL=https://pro.mairuiapi.com
MAIRUI_EGRESS_IP_EXPECTED=
